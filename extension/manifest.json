{
  "manifest_version": 3,
  "name": "Backlink Launchpad",
  "version": "1.0.0",
  "description": "Fills submit forms with your Backlink Launchpad posts. You review and submit yourself.",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": { "default_title": "Backlink Launchpad", "default_popup": "popup.html", "default_icon": { "16": "icon-16.png", "32": "icon-32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "web_accessible_resources": [{ "resources": ["icon-48.png"], "matches": ["http://*/*", "https://*/*"] }]
}
