{
  "name": "backlink-builder",
  "productName": "BacklinkBuilder",
  "version": "0.1.0",
  "description": "Campaign manager and assisted poster for backlinks and promotion",
  "private": true,
  "main": "./out/main/index.js",
  "author": "BacklinkBuilder",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:app": "electron-vite build",
    "build": "electron-vite build && electron-builder --win --x64",
    "build:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3",
      "esbuild",
      "electron-winstaller",
      "@tailwindcss/oxide"
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "playwright-core": "^1.65.1"
  }
}
