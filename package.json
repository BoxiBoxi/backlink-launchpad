{
  "name": "backlink-launchpad",
  "productName": "Backlink Launchpad",
  "version": "0.1.6",
  "license": "MIT",
  "description": "Backlink Launchpad by Wriai: plan, write and track launch posts and backlinks on 500+ directories and communities (human-in-the-loop).",
  "private": true,
  "main": "./out/main/index.js",
  "author": {
    "name": "Wriai",
    "url": "https://wriai.com"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:app": "electron-vite build",
    "build": "electron-vite build && electron-builder --win --x64 --publish never",
    "build:dir": "electron-vite build && electron-builder --win --x64 --dir --publish never",
    "postinstall": "electron-builder install-app-deps",
    "test": "esbuild scripts/test-postDetect.ts --bundle --platform=node --outfile=out/test/postDetect.cjs --log-level=warning && node out/test/postDetect.cjs && esbuild scripts/test-catalog.ts --bundle --platform=node --alias:@shared=./src/shared --outfile=out/test/catalog.cjs --log-level=warning && node out/test/catalog.cjs",
    "build:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3",
      "esbuild",
      "electron-winstaller",
      "@tailwindcss/oxide"
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.5.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.78.0",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.11",
    "playwright-core": "^1.65.1"
  },
  "homepage": "https://wriai.com"
}
